# Stage 1: Build (Debian-slim for glibc support)
FROM node:20-slim AS builder

# Accept and expose API URL at build time
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}

WORKDIR /usr/src/app

# Install all dependencies (dev + prod)
COPY package*.json ./

# Use npm install instead of npm ci to avoid lock file issues
RUN npm install

# Copy source & build
COPY . .
RUN npm run build

# Stage 2: Runtime (slim prod image)
FROM node:20-slim AS runtime
WORKDIR /usr/src/app

# Install only production dependencies
COPY package*.json ./

# Install prod dependencies only, skipping dev dependencies
RUN npm install --omit=dev

# Copy build artifacts from builder
COPY --from=builder /usr/src/app/.next ./.next
COPY --from=builder /usr/src/app/public ./public

# Expose port and start
EXPOSE 3000
ENV NODE_ENV=production
CMD ["npm", "run", "start"]
