# Stage 1: Build
FROM node:18-alpine AS builder

# 0) Accept the API URL at build time and expose to Next.js
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}

WORKDIR /usr/src/app

# 1) Install all dependencies (dev + prod)
COPY package*.json ./
RUN npm ci

# 2) Copy source and build the app
COPY . .
RUN npm run build

# Stage 2: Runtime (slim image)
FROM node:18-alpine AS runtime

WORKDIR /usr/src/app

# 1) Install only production dependencies
COPY package*.json ./
RUN npm ci --production

# 2) Copy build output and static assets from builder
COPY --from=builder /usr/src/app/.next ./.next
COPY --from=builder /usr/src/app/public ./public

# 3) Expose and run
EXPOSE 3000
ENV NODE_ENV=production
CMD ["npm", "run", "start"]
